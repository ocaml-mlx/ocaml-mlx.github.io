{
  "name": "ocaml-mlx-website",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "opam exec -- dune exec --root . site/dev.exe",
    "start": "npm run dev",
    "build": "opam exec -- dune exec --root . site/build.exe",
    "preview": "opam exec -- dune exec --root . site/preview.exe",
    "check": "opam exec -- dune build @all @fmt @runtest",
    "test": "opam exec -- dune build @checks @runtest site/build.exe site/preview.exe && opam exec -- node _build/default/checks/output/checks/build_test.js && opam exec -- node _build/default/checks/output/checks/preview_test.js && node _build/default/checks/output/checks/parity_test.js",
    "test:parity": "opam exec -- dune build @checks && node _build/default/checks/output/checks/parity.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@pagefind/default-ui": "1.4.0",
    "esbuild": "0.28.2",
    "pagefind": "1.4.0",
    "playwright": "^1.65.1"
  }
}
